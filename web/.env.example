# Copy to .env.local and fill in.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
# Use <project>.web.app rather than firebaseapp.com, so redirect sign-in works in the installed PWA.
# Add https://<project>.web.app/__/auth/handler to the OAuth client's authorized redirect URIs.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# travelin-api base URL, no trailing slash
VITE_API_URL=http://localhost:8000

# Browser Maps JavaScript API key (HTTP-referrer restricted) and Map ID
VITE_MAPS_API_KEY=
VITE_MAPS_MAP_ID=

# true = use the local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
