# Local development: copy to .env and fill in.
# Credentials come from `gcloud auth application-default login`.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
STORAGE_BUCKET=

# Pinned model IDs (never *-latest). Planner fallback chain: gemini-3.1-pro-preview, then FAST_MODEL.
FAST_MODEL=gemini-3.8-flash
PLANNER_MODEL=gemini-4-argon

# Server-only key restricted to Places API (New). In Cloud Run this comes from Secret Manager.
PLACES_API_KEY=

MERCHANT_URL=http://localhost:8001

# ES256 private key (PEM) used to sign group authorizations. Secret Manager in Cloud Run.
TRAVELIN_SIGNING_KEY=

# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
